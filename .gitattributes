# Auto-detect text files and normalize line endings
* text=auto

# Source code & configs - enforce LF
*.rs text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Windows script files
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.icns binary
*.exe binary
*.msi binary
*.dll binary
*.zip binary
